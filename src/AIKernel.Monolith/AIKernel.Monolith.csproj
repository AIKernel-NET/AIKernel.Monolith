<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AIKernel.Monolith</AssemblyName>
    <AssemblyTitle>AIKernel.Monolith</AssemblyTitle>
    <PackageId>AIKernel.Monolith</PackageId>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <AIKernelKernelProject Condition="'$(AIKernelKernelProject)' == ''">$(MSBuildThisFileDirectory)../../../AIKernel.Core/src/AIKernel.Kernel/AIKernel.Kernel.csproj</AIKernelKernelProject>
    <ChatOpenAIProviderProject Condition="'$(ChatOpenAIProviderProject)' == ''">$(MSBuildThisFileDirectory)../../../AIKernel.Providers/src/Chat/ChatOpenAIProvider/ChatOpenAIProvider.csproj</ChatOpenAIProviderProject>
    <PublishAot Condition="'$(PublishAot)' == '' and Exists('$(ChatOpenAIProviderProject)')">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Official AIKernel.Monolith Semantic OS distribution host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIKernel.Monolith.Tests" />
    <InternalsVisibleTo Include="AIKernel.Monolith.ThermalTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(AIKernelKernelProject)" Condition="Exists('$(AIKernelKernelProject)')" />
    <PackageReference Include="AIKernel.Kernel" Version="$(AIKernelKernelPackageVersion)"
                      Condition="!Exists('$(AIKernelKernelProject)') and '$(AIKernelKernelPackageVersion)' != ''" />
    <ProjectReference Include="$(ChatOpenAIProviderProject)" Condition="Exists('$(ChatOpenAIProviderProject)')" />
    <PackageReference Include="AIKernel.Providers.ChatOpenAI" Version="$(ChatOpenAIProviderPackageVersion)"
                      Condition="!Exists('$(ChatOpenAIProviderProject)') and '$(ChatOpenAIProviderPackageVersion)' != ''" />
  </ItemGroup>

  <Target Name="RequireKernel" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="!Exists('$(AIKernelKernelProject)') and '$(AIKernelKernelPackageVersion)' == ''">
    <Error Text="Provide the AIKernel.Core source checkout via AIKernelKernelProject or set AIKernelKernelPackageVersion to a package with paged CUDA support." />
  </Target>

  <Target Name="RequireChatProvider" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="!Exists('$(ChatOpenAIProviderProject)') and '$(ChatOpenAIProviderPackageVersion)' == ''">
    <Error Text="Provide the AIKernel.Providers source checkout via ChatOpenAIProviderProject or set ChatOpenAIProviderPackageVersion to a package with streaming and embedding support." />
  </Target>

  <ItemGroup Condition="'$(AIKernelNativeComputeLibrary)' != ''">
    <None Include="$(AIKernelNativeComputeLibrary)" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>samples\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
