<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIKernel.Monolith</AssemblyName>
    <AssemblyTitle>AIKernel.Monolith</AssemblyTitle>
    <PackageId>AIKernel.Monolith</PackageId>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <ChatOpenAIProviderProject Condition="'$(ChatOpenAIProviderProject)' == ''">$(MSBuildThisFileDirectory)../../../AIKernel.Providers/src/Chat/ChatOpenAIProvider/ChatOpenAIProvider.csproj</ChatOpenAIProviderProject>
    <PublishAot Condition="'$(PublishAot)' == '' and Exists('$(ChatOpenAIProviderProject)')">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Official AIKernel.Monolith Semantic OS distribution host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Core" Version="[0.1.3]" />
    <ProjectReference Include="$(ChatOpenAIProviderProject)" Condition="Exists('$(ChatOpenAIProviderProject)')" />
    <PackageReference Include="AIKernel.Providers.ChatOpenAI" Version="[0.1.3]" Condition="!Exists('$(ChatOpenAIProviderProject)')" />
  </ItemGroup>

  <Target Name="RequireAotChatProvider" BeforeTargets="PrepareForPublish"
          Condition="'$(PublishAot)' == 'true' and !Exists('$(ChatOpenAIProviderProject)')">
    <Error Text="Native AOT requires the AIKernel.Providers source checkout with the AOT-safe ChatOpenAI client. Set ChatOpenAIProviderProject to its project path." />
  </Target>

  <ItemGroup>
    <None Include="..\..\samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>samples\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
