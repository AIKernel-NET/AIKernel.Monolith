FROM mcr.microsoft.com/dotnet/sdk:10.0-preview AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/AIKernel.Monolith/AIKernel.Monolith.csproj -c Release -r linux-x64 --self-contained true -o /out /p:PublishAot=true

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-preview
WORKDIR /aikernel
COPY --from=build /out/ ./
COPY samples/ /aikernel/samples/
COPY docker/docker-entrypoint.sh /aikernel/docker-entrypoint.sh
RUN chmod +x /aikernel/docker-entrypoint.sh
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/aikernel/docker-entrypoint.sh"]
